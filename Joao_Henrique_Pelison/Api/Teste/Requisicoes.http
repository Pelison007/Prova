@baseUrl = http://localhost:5286
### Raiz do Projeto
GET {{baseUrl}}

### -- Cadastrar
POST {{baseUrl}}/api/folha/cadastrar
Content-Type: application/json

{
    "nome": "joao",
    "cpf": "123.456.789-00",
    "mes": 4,
    "ano": 2020,
    "horasTrabalhadas": 200,
    "valorHora": 10
}

### -- listar
GET {{baseUrl}}/api/folha/listar

### -- CPF / MES / ANO
GET {{baseUrl}}/api/folha/buscar/12345678900/4/2020

### -- Excluir folhas de pagamento 
DELETE {{baseUrl}}/api/folha/remover/12345678900/3/2020

### -- Total líquido
GET {{baseUrl}}/api/folha/total-liquido